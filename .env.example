# VITE_API_BASE_URL
# Required: OPTIONAL
# Runtime impact if missing: Defaults to same-origin endpoint routing.
VITE_API_BASE_URL=

# VITE_BASE_PATH
# Required: OPTIONAL
# Runtime impact if missing: Uses '/' base path for routing/assets.
VITE_BASE_PATH=/

# VITE_AUTH_EMAIL
# Required: OPTIONAL
# Runtime impact if missing: Uses default operator email 'admin@lingbot.io'.
VITE_AUTH_EMAIL=admin@lingbot.io

# VITE_AUTH_PASSWORD
# Required: OPTIONAL
# Runtime impact if missing: Uses default operator password 'P@ssword1'.
VITE_AUTH_PASSWORD=P@ssword1
